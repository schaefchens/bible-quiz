# Absolute base URL of the PHP backend folder.
#
# Leave this UNSET for the web build and for `npm run dev`: the app then calls
# /api/… on its own origin, which dev proxies to the Node server and production
# serves from the htaccess-protected PHP folder.
#
# SET it for Capacitor (Android/iOS) builds. A packaged app is served from
# capacitor://localhost, so it has no origin of its own that /api/… could
# resolve against and must address the server absolutely:
#
#   VITE_API_BASE=https://biblequiz.games.schaefchens.de/api/
